
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f2f5fa;
}

header {
    background: #172554;
    color: white;
    padding: 20px;
    text-align: center;
}

nav a {
    color: white;
    margin: 15px;
    text-decoration: none;
}

.hero {
    text-align: center;
    background: #dbeafe;
    padding: 60px 20px;
}

section {
    background: white;
    margin: 25px;
    padding: 25px;
    border-radius: 10px;
}

input, select {
    display: block;
    padding: 12px;
    margin: 12px 0;
    width: 90%;
    max-width: 400px;
}

button {
    background: #2563eb;
    color: white;
    padding: 12px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background: #1e40af;
}

.job-card {
    background: #eff6ff;
    margin: 10px 0;
    padding: 15px;
    border-radius: 8px;
}
