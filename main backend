
package com.jobboard;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.web.bind.annotation.*;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import java.util.*;

@SpringBootApplication
@RestController
@RequestMapping("/api")
@CrossOrigin(origins = "*")
public class JobBoardApplication {

    @Autowired
    private JdbcTemplate db;

    public static void main(String[] args) {
        SpringApplication.run(JobBoardApplication.class, args);
    }

    // USER REGISTRATION
    @PostMapping("/users/register")
    public String register(@RequestBody Map<String, String> data) {
        try {
            db.update(
                "INSERT INTO users(name,email,password,role) VALUES(?,?,?,?)",
                data.get("name"),
                data.get("email"),
                data.get("password"),
                data.get("role")
            );
            return "Registration Successful!";
        } catch (Exception e) {
            return "Registration failed: " + e.getMessage();
        }
    }

    // USER LOGIN
    @PostMapping("/users/login")
    public ResponseEntity<?> login(@RequestBody Map<String, String> data) {
        List<Map<String, Object>> users = db.queryForList(
            "SELECT id,name,email,role FROM users WHERE email=? AND password=?",
            data.get("email"), data.get("password")
        );

        if (users.isEmpty()) {
            return ResponseEntity.status(401).body("Invalid Login");
        }

        return ResponseEntity.ok(users.get(0));
    }

    // POST JOB
    @PostMapping("/jobs")
    public String postJob(@RequestBody Map<String, String> job) {
        db.update(
            "INSERT INTO jobs(title,company,location) VALUES(?,?,?)",
            job.get("title"),
            job.get("company"),
            job.get("location")
        );
        return "Job Posted Successfully!";
    }

    // VIEW ALL JOBS
    @GetMapping("/jobs")
    public List<Map<String, Object>> getJobs() {
        return db.queryForList("SELECT * FROM jobs");
    }

    // SEARCH JOB
    @GetMapping("/jobs/search")
    public List<Map<String, Object>> searchJobs(
        @RequestParam String keyword) {

        return db.queryForList(
            "SELECT * FROM jobs WHERE title LIKE ? OR company LIKE ?",
            "%" + keyword + "%",
            "%" + keyword + "%"
        );
    }

    // APPLY FOR JOB
    @PostMapping("/applications")
    public String applyJob(@RequestBody Map<String, Object> data) {
        db.update(
            "INSERT INTO applications(job_id,email) VALUES(?,?)",
            data.get("jobId"),
            data.get("email")
        );
        return "Application Submitted Successfully!";
    }

    // VIEW APPLICATIONS
    @GetMapping("/applications")
    public List<Map<String, Object>> getApplications() {
        return db.queryForList(
            "SELECT * FROM applications"
        );
    }

    // CREATE RECRUITMENT EVENT
    @PostMapping("/events")
    public String createEvent(@RequestBody Map<String, String> event) {
        db.update(
            "INSERT INTO events(name,date,location) VALUES(?,?,?)",
            event.get("name"),
            event.get("date"),
            event.get("location")
        );
        return "Event Created Successfully!";
    }

    // VIEW EVENTS
    @GetMapping("/events")
    public List<Map<String, Object>> getEvents() {
        return db.queryForList("SELECT * FROM events");
    }

    // REGISTER EVENT PARTICIPANT
    @PostMapping("/events/register")
    public String registerParticipant(
        @RequestBody Map<String, Object> data) {

        db.update(
            "INSERT INTO participants(event_id,name,email) VALUES(?,?,?)",
            data.get("eventId"),
            data.get("name"),
            data.get("email")
        );

        return "Event Registration Successful!";
    }

    // VIEW EVENT PARTICIPANTS
    @GetMapping("/events/participants")
    public List<Map<String, Object>> getParticipants() {
        return db.queryForList(
            "SELECT * FROM participants"
        );
    }

    // ADMIN DASHBOARD
    @GetMapping("/admin/dashboard")
    public Map<String, Object> dashboard() {
        Map<String, Object> result = new HashMap<>();

        result.put("users",
            db.queryForObject("SELECT COUNT(*) FROM users", Integer.class));

        result.put("jobs",
            db.queryForObject("SELECT COUNT(*) FROM jobs", Integer.class));

        result.put("applications",
            db.queryForObject("SELECT COUNT(*) FROM applications", Integer.class));

        result.put("events",
            db.queryForObject("SELECT COUNT(*) FROM events", Integer.class));

        result.put("participants",
            db.queryForObject("SELECT COUNT(*) FROM participants", Integer.class));

        return result;
    }
}
